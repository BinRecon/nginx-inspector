[Unit]
Description=Nginx Inspector Monitoring Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/nginx-inspector
EnvironmentFile=/usr/local/nginx-inspector/.env
ExecStart=/usr/local/nginx-inspector/venv/bin/python /usr/local/nginx-inspector/api/api-server.py
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nginx-inspector

[Install]
WantedBy=multi-user.target
