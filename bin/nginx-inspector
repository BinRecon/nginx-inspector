#!/bin/bash

# Nginx Inspector - Command Line Interface
# Advanced Nginx Log Analyzer with Web Dashboard & REST API
# Version: 1.0.0

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Configuration
INSTALL_DIR="/usr/local/nginx-inspector"
VENV_DIR="$INSTALL_DIR/venv"
API_SERVER="$INSTALL_DIR/api/api-server.py"
SHELL_ANALYZER="$INSTALL_DIR/bin/nginx-inspector.sh"
ATTACK_DETECTOR="$INSTALL_DIR/bin/attack-detector.sh"
WEB_DASHBOARD="$INSTALL_DIR/web/index.html"
ENV_FILE="$INSTALL_DIR/.env"
SERVICE_FILE="/etc/systemd/system/nginx-inspector.service"
SYMLINK="/usr/local/bin/nginx-inspector"

# Error handler
error_exit() {
    echo -e "${RED}✗ Error: $1${NC}" >&2
    exit 1
}

success_msg() {
    echo -e "${GREEN}✓ $1${NC}"
}

info_msg() {
    echo -e "${BLUE}ℹ $1${NC}"
}

warning_msg() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

# Function to display version
show_version() {
    echo -e "${CYAN}Nginx Inspector${NC} v1.0.0"
    echo "Advanced Nginx Log Analyzer with Web Dashboard & REST API"
}

# Function to display help
show_help() {
    cat << EOF
${CYAN}Nginx Inspector - Command Line Interface${NC}

${GREEN}Usage:${NC}
  nginx-inspector [COMMAND] [OPTIONS]

${GREEN}Commands:${NC}
  start                         Start nginx-inspector service
  stop                          Stop nginx-inspector service
  restart                       Restart nginx-inspector service
  status                        Show service status
  analyze <logfile>             Analyze a specific nginx log file
  attack <logfile>              Run security threat detection
  api                           Start REST API server (port 8765)
  web                           Open web dashboard
  uninstall                     Uninstall nginx-inspector completely
  version, --version, -v        Show version information
  help, --help, -h              Show this help message

${GREEN}Examples:${NC}
  nginx-inspector start
  nginx-inspector analyze /var/log/nginx/access.log
  nginx-inspector attack /var/log/nginx/access.log
  nginx-inspector api
  nginx-inspector uninstall

${GREEN}Documentation:${NC}
  https://github.com/BinRecon/nginx-inspector

EOF
}

# Function to verify installation
verify_installation() {
    if [ ! -d "$INSTALL_DIR" ]; then
        error_exit "Installation directory not found: $INSTALL_DIR\nPlease run: sudo bash install.sh"
    fi
    
    if [ ! -d "$VENV_DIR" ]; then
        error_exit "Virtual environment not found: $VENV_DIR\nPlease run: sudo bash install.sh"
    fi
}

# Function to check if systemd service exists
check_service() {
    if ! command -v systemctl &> /dev/null; then
        error_exit "systemctl not found. This system may not use systemd."
    fi
}

# Function to uninstall
uninstall_app() {
    # Check if running with sudo
    if [ "$EUID" -ne 0 ]; then
        error_exit "Uninstallation must be run with sudo"
    fi

    echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║   Nginx Inspector Uninstallation     ║${NC}"
    echo -e "${CYAN}║    Version: 1.0.0                     ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
    echo ""

    # Confirmation prompt
    echo -e "${YELLOW}⚠ WARNING: This will remove all Nginx Inspector files!${NC}"
    echo ""
    echo "This action will:"
    echo "  • Stop the nginx-inspector service"
    echo "  • Remove $INSTALL_DIR directory"
    echo "  • Remove $SYMLINK symlink"
    echo "  • Remove $SERVICE_FILE"
    echo "  • Remove Python virtual environment"
    echo ""
    read -p "Are you sure you want to continue? (yes/no): " confirmation

    if [ "$confirmation" != "yes" ]; then
        echo -e "${YELLOW}Uninstallation cancelled${NC}"
        exit 0
    fi

    echo ""

    # Step 1: Stop the service if running
    info_msg "Stopping nginx-inspector service..."

    if check_service &> /dev/null; then
        if systemctl is-active --quiet nginx-inspector 2>/dev/null; then
            systemctl stop nginx-inspector 2>/dev/null || warning_msg "Failed to stop service (may already be stopped)"
            success_msg "Service stopped"
        else
            warning_msg "Service is not running"
        fi
    fi

    echo ""

    # Step 2: Disable the service
    info_msg "Disabling nginx-inspector service..."

    if [ -f "$SERVICE_FILE" ]; then
        if systemctl is-enabled --quiet nginx-inspector 2>/dev/null; then
            systemctl disable nginx-inspector > /dev/null 2>&1 || warning_msg "Failed to disable service"
            success_msg "Service disabled"
        else
            warning_msg "Service is not enabled"
        fi
    fi

    echo ""

    # Step 3: Reload systemd daemon
    info_msg "Reloading systemd daemon..."

    if command -v systemctl &> /dev/null; then
        systemctl daemon-reload 2>/dev/null || warning_msg "Failed to reload systemd"
        success_msg "Systemd daemon reloaded"
    fi

    echo ""

    # Step 4: Remove systemd service file
    info_msg "Removing systemd service file..."

    if [ -f "$SERVICE_FILE" ]; then
        rm -f "$SERVICE_FILE" || error_exit "Failed to remove service file"
        success_msg "Service file removed: $SERVICE_FILE"
    else
        warning_msg "Service file not found: $SERVICE_FILE"
    fi

    echo ""

    # Step 5: Remove symlink
    info_msg "Removing command-line symlink..."

    if [ -L "$SYMLINK" ]; then
        rm -f "$SYMLINK" || error_exit "Failed to remove symlink"
        success_msg "Symlink removed: $SYMLINK"
    else
        warning_msg "Symlink not found: $SYMLINK"
    fi

    echo ""

    # Step 6: Remove installation directory
    info_msg "Removing installation directory..."

    if [ -d "$INSTALL_DIR" ]; then
        rm -rf "$INSTALL_DIR" || error_exit "Failed to remove installation directory"
        success_msg "Installation directory removed: $INSTALL_DIR"
    else
        warning_msg "Installation directory not found: $INSTALL_DIR"
    fi

    echo ""

    # Step 7: Clean up cache
    info_msg "Cleaning up temporary files..."

    if [ -d "$HOME/.cache" ]; then
        find "$HOME/.cache" -name "*nginx-inspector*" -type d -exec rm -rf {} + 2>/dev/null || true
        success_msg "Cache cleaned"
    fi

    echo ""

    # Step 8: Kill any leftover processes
    info_msg "Checking for leftover processes..."

    if pgrep -f nginx-inspector > /dev/null; then
        warning_msg "Some nginx-inspector processes are still running"
        echo "Attempting to kill processes..."
        pkill -f nginx-inspector || warning_msg "Failed to kill processes"
        success_msg "Processes terminated"
    else
        success_msg "No leftover processes found"
    fi

    echo ""

    # Step 9: Verification
    info_msg "Verifying uninstallation..."

    errors_found=0

    if [ -d "$INSTALL_DIR" ]; then
        warning_msg "Installation directory still exists: $INSTALL_DIR"
        errors_found=$((errors_found + 1))
    else
        success_msg "Installation directory removed ✓"
    fi

    if [ -L "$SYMLINK" ]; then
        warning_msg "Symlink still exists: $SYMLINK"
        errors_found=$((errors_found + 1))
    else
        success_msg "Symlink removed ✓"
    fi

    if [ -f "$SERVICE_FILE" ]; then
        warning_msg "Service file still exists: $SERVICE_FILE"
        errors_found=$((errors_found + 1))
    else
        success_msg "Service file removed ✓"
    fi

    echo ""

    # Final message
    if [ $errors_found -eq 0 ]; then
        echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║   Uninstallation Complete! ✓          ║${NC}"
        echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "${GREEN}Nginx Inspector has been completely removed${NC}"
        echo ""
        echo "Optional cleanup:"
        echo "  • Python packages: pip uninstall flask flask-cors python-dotenv"
        echo "  • Nginx logs: sudo rm /var/log/nginx/access.log*"
        echo ""
    else
        echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
        echo -e "${CYAN}║   Uninstallation Complete (with warnings) ║${NC}"
        echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
        echo ""
        warning_msg "Some files could not be removed. See above for details."
        echo ""
    fi
}

# Main command handler
case "$1" in
    start)
        check_service
        info_msg "Starting nginx-inspector service..."
        
        if sudo systemctl start nginx-inspector; then
            success_msg "Service started successfully"
            echo -e "${CYAN}API Server:${NC} http://localhost:8765"
            echo -e "${CYAN}Web Dashboard:${NC} http://localhost:8080"
        else
            error_exit "Failed to start service. Check logs: sudo journalctl -u nginx-inspector -n 50"
        fi
        ;;
    
    stop)
        check_service
        info_msg "Stopping nginx-inspector service..."
        
        if sudo systemctl stop nginx-inspector; then
            success_msg "Service stopped successfully"
        else
            error_exit "Failed to stop service"
        fi
        ;;
    
    restart)
        check_service
        info_msg "Restarting nginx-inspector service..."
        
        if sudo systemctl restart nginx-inspector; then
            success_msg "Service restarted successfully"
        else
            error_exit "Failed to restart service. Check logs: sudo journalctl -u nginx-inspector -n 50"
        fi
        ;;
    
    status)
        check_service
        sudo systemctl status nginx-inspector
        ;;
    
    analyze)
        if [ -z "$2" ]; then
            error_exit "Log file path required\nUsage: nginx-inspector analyze <logfile>"
        fi
        
        if [ ! -f "$2" ]; then
            error_exit "Log file not found: $2"
        fi
        
        verify_installation
        
        if [ ! -f "$SHELL_ANALYZER" ]; then
            error_exit "Analyzer script not found: $SHELL_ANALYZER"
        fi
        
        info_msg "Analyzing log file: $2"
        bash "$SHELL_ANALYZER" "$2"
        ;;
    
    attack)
        if [ -z "$2" ]; then
            error_exit "Log file path required\nUsage: nginx-inspector attack <logfile>"
        fi
        
        if [ ! -f "$2" ]; then
            error_exit "Log file not found: $2"
        fi
        
        verify_installation
        
        if [ ! -f "$ATTACK_DETECTOR" ]; then
            error_exit "Attack detector script not found: $ATTACK_DETECTOR"
        fi
        
        info_msg "Running threat detection on: $2"
        bash "$ATTACK_DETECTOR" "$2"
        ;;
    
    api)
        verify_installation
        
        if [ ! -f "$API_SERVER" ]; then
            error_exit "API server not found: $API_SERVER"
        fi
        
        info_msg "Starting API server..."
        
        # Load environment variables if .env exists
        if [ -f "$ENV_FILE" ]; then
            set -a
            source "$ENV_FILE"
            set +a
        fi
        
        # Check if port is already in use
        if command -v lsof &> /dev/null; then
            PORT="${PORT:-8765}"
            if lsof -i ":$PORT" > /dev/null 2>&1; then
                error_exit "Port $PORT is already in use. Change PORT in .env or kill the process."
            fi
        fi
        
        success_msg "API server running on http://localhost:${PORT:-8765}"
        echo -e "${YELLOW}Press Ctrl+C to stop${NC}"
        echo ""
        
        # Activate virtual environment and run API server
        source "$VENV_DIR/bin/activate"
        python "$API_SERVER"
        ;;
    
    web)
        verify_installation
        
        if [ ! -f "$WEB_DASHBOARD" ]; then
            error_exit "Web dashboard not found: $WEB_DASHBOARD"
        fi
        
        info_msg "Opening web dashboard..."
        
        # Try to open in browser
        if command -v xdg-open &> /dev/null; then
            xdg-open "file://$WEB_DASHBOARD"
        elif command -v open &> /dev/null; then
            open "file://$WEB_DASHBOARD"
        else
            warning_msg "Could not open browser automatically"
            echo -e "${CYAN}Open manually:${NC} file://$WEB_DASHBOARD"
        fi
        ;;
    
    uninstall)
        uninstall_app
        ;;
    
    version|--version|-v)
        show_version
        ;;
    
    help|--help|-h)
        show_help
        ;;
    
    *)
        if [ -z "$1" ]; then
            show_help
            exit 0
        else
            echo -e "${RED}✗ Unknown command: $1${NC}"
            echo ""
            show_help
            exit 1
        fi
        ;;
esac

exit 0
