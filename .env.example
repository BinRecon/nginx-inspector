# Nginx Inspector API Configuration
# =====================================
# Copy this file to .env and update values as needed
# IMPORTANT: See API Key generation section below

# API Server Settings
# ===================================================
# HOST: Bind to specific IP (default: 127.0.0.1 for localhost only)
# Set to 0.0.0.0 to accept connections from any IP (less secure)
HOST=127.0.0.1

# API_PORT: Port number for REST API server
API_PORT=8765

# DEBUG: Enable debug mode (set to False in production)
DEBUG=False

# Web Dashboard Settings
# ===================================================
WEB_PORT=8080

# API Key Configuration (CRITICAL SECURITY)
# ===================================================
# DO NOT use default keys in production!
# Generate a secure API key using:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# The API key is used to authenticate requests to protected endpoints:
# - POST /api/security/block-ip
# - PUT /api/settings
# - Report generation endpoints
#
# NEVER commit the real API key to version control
# Always use environment variables in production
#
# Example secure key generation:
#   export NGINX_INSPECTOR_API_KEY=$(python3 -c "import secrets; print(secrets.token_hex(32))")
#
NGINX_INSPECTOR_API_KEY=your-secure-api-key-here

# Nginx Log File Path
# ===================================================
# Path to Nginx access log file
# Common locations:
#   - /var/log/nginx/access.log (Debian/Ubuntu)
#   - /var/log/nginx/access.log (CentOS)
#   - /usr/local/nginx/logs/access.log (from source)
DEFAULT_LOG_FILE=/var/log/nginx/access.log

# CORS Settings
# ===================================================
# CORS_ORIGINS: Comma-separated list of allowed origins
# Examples:
#   CORS_ORIGINS=*                          (allow all - NOT recommended)
#   CORS_ORIGINS=https://yourdomain.com     (specific domain)
#   CORS_ORIGINS=https://yourdomain.com,http://localhost:3000  (multiple)
CORS_ORIGINS=http://localhost:8080

# Security Best Practices
# ===================================================
# 1. Change the API key in production
# 2. Set HOST to 127.0.0.1 unless you need remote access
# 3. Use HTTPS in production with a reverse proxy (Nginx/Apache)
# 4. Restrict CORS_ORIGINS to your specific domains
# 5. Keep DEBUG=False in production
# 6. Use a firewall to limit access to port 8765
# 7. Rotate API keys regularly
# 8. Keep the .env file permissions restricted (chmod 600)
